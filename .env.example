# Configure these in Netlify: Site configuration > Environment variables.
# Never put the Supabase service-role key in HTML or browser JavaScript.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
ADMIN_API_KEY=replace-with-a-long-random-secret-at-least-32-characters
